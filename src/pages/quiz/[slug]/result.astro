---
import Base from '../../../layouts/Base.astro';
import AdSlot from '../../../components/AdSlot.astro';
import EmailCapture from '../../../components/EmailCapture.astro';
import { QUIZZES, getQuiz } from '../../../lib/quizzes';
import { findSport, findTournament } from '../../../data/sports';
import { SITE, INTEGRATIONS } from '../../../lib/site';
import { FIXTURES, fixtureUrl, isFinished } from '../../../lib/predictions';

export function getStaticPaths() {
  return QUIZZES.map((quiz) => ({ params: { slug: quiz.slug } }));
}

const { slug } = Astro.params;
const quiz = getQuiz(slug!)!;
const total = quiz.questions.length;
const playHref = `/quiz/${quiz.slug}/1/`;
const shareUrl = `${SITE.url}/quiz/${quiz.slug}/`;
const relatedFixtures = quiz.teams
  ? FIXTURES.filter(
      (f) => !f.tbd && !isFinished(f) &&
        (quiz.teams!.includes(f.home) || quiz.teams!.includes(f.away))
    ).slice(0, 2)
  : [];

const others = QUIZZES.filter((q) => q.slug !== slug && !q.daily);
const sameCategory = others.filter((q) => q.category === quiz.category);
const nextQuizzes = (sameCategory.length >= 2 ? sameCategory : others).slice(0, 2);

const sportData = findSport(quiz.sport);
const tData = findTournament(quiz.sport, quiz.tournament);
const breadcrumbs = [
  { label: sportData?.name ?? 'Quizzes', href: `/${quiz.sport}/` },
  { label: tData?.name ?? 'World Cup 2026', href: `/${quiz.sport}/${quiz.tournament}/` },
  { label: quiz.title, href: `/quiz/${quiz.slug}/` },
  { label: 'Result', href: '' },
];
---
<Base
  title={`${quiz.title} — Your score`}
  description={`How well do you know ${quiz.title}? ${total} questions — share your score and challenge your friends!`}
  image={`${SITE.url}/og/${quiz.slug}.png`}
  breadcrumbs={breadcrumbs}
>
  <div class="text-center">
    <div class="text-5xl">{quiz.emoji ?? '🏆'}</div>
    <h1 class="mt-3 text-2xl font-bold">Your score</h1>
    <p id="score" class="mt-2 text-4xl font-extrabold text-pitch">…/{total}</p>
    <p id="verdict" class="mt-1 text-slate-500"></p>
    <p id="streak" class="mt-2 hidden text-sm font-bold text-amber-600"></p>
  </div>

  <AdSlot label="Results ad" />

  <div class="mt-6 grid gap-2">
    <p class="text-center text-sm font-medium text-slate-600">Challenge your friends 👇</p>
    <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
      <a id="sh-wa" target="_blank" rel="noopener" class="rounded-lg bg-green-600 px-3 py-2 text-center text-sm font-semibold text-white">WhatsApp</a>
      <a id="sh-x" target="_blank" rel="noopener" class="rounded-lg bg-slate-900 px-3 py-2 text-center text-sm font-semibold text-white">X</a>
      <a id="sh-tg" target="_blank" rel="noopener" class="rounded-lg bg-sky-500 px-3 py-2 text-center text-sm font-semibold text-white">Telegram</a>
      <button id="sh-fb" class="rounded-lg bg-blue-600 px-3 py-2 text-center text-sm font-semibold text-white">Facebook</button>
    </div>
    <button id="copy" class="mt-1 rounded-lg border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">Copy link</button>
  </div>
  <p id="fb-toast" class="hidden mt-2 text-center text-xs text-blue-600 font-medium"></p>

  <EmailCapture />

  {relatedFixtures.length > 0 && (
    <section class="mt-6">
      <p class="mb-2 text-sm font-semibold text-slate-600">📊 Predict the next match</p>
      <div class="grid gap-2">
        {relatedFixtures.map((f) => (
          <a href={fixtureUrl(f)} class="flex items-center justify-between rounded-xl border border-slate-200 bg-white p-3 hover:border-pitch">
            <span class="text-sm font-semibold">{f.home} <span class="font-normal text-slate-400">vs</span> {f.away}</span>
            <span class="text-xs font-medium text-pitch">Predict →</span>
          </a>
        ))}
      </div>
    </section>
  )}

  {nextQuizzes.length > 0 && (
    <section class="mt-6">
      <p class="mb-2 text-sm font-semibold text-slate-600">🎯 Play next</p>
      <div class="grid gap-2">
        {nextQuizzes.map((q) => (
          <a href={`/quiz/${q.slug}/`} class="flex items-center gap-3 rounded-xl border border-slate-200 bg-white p-3 hover:border-pitch">
            <span class="text-2xl">{q.emoji ?? '⚽'}</span>
            <div class="flex-1">
              <p class="text-sm font-semibold">{q.title}</p>
              <p class="text-xs text-slate-400">{q.questions.length} questions</p>
            </div>
            <span class="text-xs font-medium text-pitch">Play →</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <div class="mt-6 flex flex-wrap justify-center gap-3">
    <a href={playHref} class="rounded-xl border border-slate-300 px-5 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50">Play again</a>
    <a href={`/${quiz.sport}/${quiz.tournament}/`} class="rounded-xl bg-pitch px-5 py-2 text-sm font-semibold text-white hover:bg-pitch-dark">All quizzes</a>
  </div>

  <script is:inline define:vars={{ slug: quiz.slug, total, title: quiz.title, shareUrl, voteApi: INTEGRATIONS.voteApi }}>
    const KEY = 'wsq:' + slug;
    const state = JSON.parse(localStorage.getItem(KEY) || '{"answers":{}}');
    const score = Object.values(state.answers || {}).filter(Boolean).length;
    document.getElementById('score').textContent = score + '/' + total;

    const pct = total ? score / total : 0;
    const verdict =
      pct === 1 ? 'Perfect! You are a true superfan. 🐐' :
      pct >= 0.7 ? 'Great score! 🔥' :
      pct >= 0.4 ? 'Not bad — room to improve. 💪' :
      'Ouch. Time to brush up! 📚';
    document.getElementById('verdict').textContent = verdict;

    const emoji = pct === 1 ? '🐐' : pct >= 0.7 ? '🔥' : pct >= 0.4 ? '💪' : '📚';
    // Wordle-style result grid from the stored answers, in question order.
    const grid = Array.from({ length: total }, (_, i) =>
      state.answers && (i + 1) in state.answers ? (state.answers[i + 1] ? '✅' : '❌') : '⬜'
    ).join('');
    const text = `⚽ I scored ${score}/${total} on the "${title}" quiz! ${emoji}\n${grid}\nCan you beat me? 🏆`;
    const u = encodeURIComponent(shareUrl);
    const t = encodeURIComponent(text);
    document.getElementById('sh-wa').href = `https://wa.me/?text=${t}%20${u}`;
    document.getElementById('sh-x').href = `https://twitter.com/intent/tweet?text=${t}&url=${u}`;
    document.getElementById('sh-tg').href = `https://t.me/share/url?url=${u}&text=${t}`;
    document.getElementById('sh-fb').addEventListener('click', () => {
      const fbWin = window.open(`https://www.facebook.com/sharer/sharer.php?u=${u}`, '_blank', 'noopener');
      const toast = document.getElementById('fb-toast');
      navigator.clipboard.writeText(text).then(() => {
        toast.textContent = '✅ Score copied to clipboard! Paste it into your Facebook post.';
      }).catch(() => {
        toast.textContent = '📋 Copy your score above and paste it into your Facebook post.';
      }).finally(() => {
        toast.classList.remove('hidden');
        setTimeout(() => toast.classList.add('hidden'), 6000);
      });
    });

    document.getElementById('copy').addEventListener('click', async (e) => {
      try {
        await navigator.clipboard.writeText(text + ' ' + shareUrl);
        e.target.textContent = 'Copied! ✅';
        setTimeout(() => (e.target.textContent = 'Copy link'), 1500);
      } catch {}
    });

    if (window.gtag) window.gtag('event', 'quiz_complete', { quiz: slug, score });

    // Daily streak: one global counter across all quizzes.
    try {
      const SKEY = 'wsq:streak';
      const today = new Date().toISOString().slice(0, 10);
      const yest = new Date(Date.now() - 864e5).toISOString().slice(0, 10);
      const s = JSON.parse(localStorage.getItem(SKEY) || '{"count":0,"lastDate":""}');
      if (s.lastDate !== today) {
        s.count = s.lastDate === yest ? s.count + 1 : 1;
        s.lastDate = today;
        localStorage.setItem(SKEY, JSON.stringify(s));
        if (window.gtag) window.gtag('event', 'streak', { days: s.count });
      }
      if (s.count >= 1) {
        const el = document.getElementById('streak');
        el.textContent = s.count === 1
          ? '🔥 Quiz streak started — come back tomorrow to make it 2!'
          : `🔥 ${s.count}-day quiz streak!`;
        el.classList.remove('hidden');
      }
    } catch {}

    // Record the score for the anonymous leaderboard (best effort).
    try {
      if (voteApi) {
        let device = localStorage.getItem('wsq:device');
        if (!device) {
          device = (crypto.randomUUID ? crypto.randomUUID() : String(Date.now()) + '-' + Math.random().toString(36).slice(2)).toLowerCase();
          localStorage.setItem('wsq:device', device);
        }
        fetch(voteApi + '/record', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ device, quiz: slug, score, total }),
        }).catch(() => {});
      }
    } catch {}
  </script>
</Base>
