---
import Base from '../../../layouts/Base.astro';
import { QUIZZES, getQuiz } from '../../../lib/quizzes';
import { findSport, findTournament } from '../../../data/sports';
import { SITE } from '../../../lib/site';

export function getStaticPaths() {
  return QUIZZES.map((quiz) => ({ params: { slug: quiz.slug } }));
}

const { slug } = Astro.params;
const quiz = getQuiz(slug!)!;
const total = quiz.questions.length;
const playHref = `/quiz/${quiz.slug}/1/`;
const image = `${SITE.url}/og/${quiz.slug}.png`;

const others = QUIZZES.filter((q) => q.slug !== slug && !q.daily);
const sameCategory = others.filter((q) => q.category === quiz.category);
const related = (sameCategory.length >= 3 ? sameCategory : others).slice(0, 3);

const sportData = findSport(quiz.sport);
const tData = findTournament(quiz.sport, quiz.tournament);
const breadcrumbs = [
  { label: sportData?.name ?? 'Quizzes', href: `/${quiz.sport}/` },
  { label: tData?.name ?? 'World Cup 2026', href: `/${quiz.sport}/${quiz.tournament}/` },
  { label: quiz.title, href: '' },
];

const quizSchema = {
  '@context': 'https://schema.org',
  '@type': 'Quiz',
  name: quiz.title,
  description: quiz.description,
  url: `${SITE.url}/quiz/${quiz.slug}/`,
  numberOfQuestions: total,
  educationalLevel: 'beginner',
  about: { '@type': 'Thing', name: tData?.name ?? 'FIFA World Cup 2026' },
};
---
<Base
  title={`${quiz.title} — Free Quiz`}
  description={`${quiz.description} ${total} free questions — play now and share your score.`}
  image={image}
  breadcrumbs={breadcrumbs}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(quizSchema)} />

  <div class="text-center">
    <div class="text-6xl">{quiz.emoji ?? '🏆'}</div>
    <h1 class="mt-4 text-2xl font-bold text-slate-900 sm:text-3xl">{quiz.title}</h1>
    <p class="mx-auto mt-3 max-w-xl text-slate-600">{quiz.description}</p>

    <div class="mt-4 flex items-center justify-center gap-3 text-sm text-slate-500">
      <span class="rounded-full bg-slate-100 px-3 py-1 font-medium">{total} questions</span>
      {quiz.category && <span class="rounded-full bg-slate-100 px-3 py-1 font-medium">{quiz.category}</span>}
      <span class="rounded-full bg-slate-100 px-3 py-1 font-medium">Free · no sign-up</span>
    </div>

    <p id="challenge-banner" class="mx-auto mt-6 hidden max-w-md rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm font-semibold text-amber-800"></p>

    <a
      href={playHref}
      class="mt-8 inline-block rounded-xl bg-pitch px-10 py-3.5 text-lg font-bold text-white shadow-sm hover:bg-pitch-dark"
    >
      Start quiz →
    </a>
    <p class="mt-3 text-xs text-slate-400">Answer all {total}, get your score, challenge your friends.</p>
  </div>

  {related.length > 0 && (
    <section class="mt-10">
      <p class="mb-2 text-sm font-semibold text-slate-600">🎯 More quizzes</p>
      <div class="grid gap-2">
        {related.map((q) => (
          <a href={`/quiz/${q.slug}/`} class="flex items-center gap-3 rounded-xl border border-slate-200 bg-white p-3 hover:border-pitch">
            <span class="text-2xl">{q.emoji ?? '⚽'}</span>
            <div class="flex-1">
              <p class="text-sm font-semibold">{q.title}</p>
              <p class="text-xs text-slate-400">{q.questions.length} questions</p>
            </div>
            <span class="text-xs font-medium text-pitch">Play →</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <script is:inline define:vars={{ max: total }}>
    // Beat-my-score hook when arriving from a shared result link (?c=score-total).
    const raw = new URLSearchParams(location.search).get('c');
    if (raw && /^\d+-\d+$/.test(raw)) {
      const [score, total] = raw.split('-').map(Number);
      if (total > 0 && score >= 0 && score <= total && total <= max) {
        const banner = document.getElementById('challenge-banner');
        if (banner) {
          banner.textContent = `🔥 A friend scored ${score}/${total} — can you beat them?`;
          banner.classList.remove('hidden');
        }
      }
    }
  </script>
</Base>
