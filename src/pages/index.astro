---
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';
import QuizCard from '../components/QuizCard.astro';
import Leaderboard from '../components/Leaderboard.astro';
import { SPORTS } from '../data/sports';
import { QUIZZES, dailyQuiz } from '../lib/quizzes';
import { SITE } from '../lib/site';
import { fixturesByDate, fixtureUrl, ROUND_LABELS, isFinished } from '../lib/predictions';

const daily = dailyQuiz();

const todayStr = new Date().toISOString().slice(0, 10);
const allDays = fixturesByDate();
const upcomingDay = allDays.find((d) => d.date >= todayStr && d.fixtures.some((f) => !isFinished(f)));
const sevenDaysMs = 7 * 24 * 60 * 60 * 1000;
const withinWeek = upcomingDay &&
  new Date(upcomingDay.date + 'T00:00:00Z').getTime() - new Date(todayStr + 'T00:00:00Z').getTime() <= sevenDaysMs;
const upcomingFixtures = withinWeek ? upcomingDay!.fixtures.filter((f) => !isFinished(f)).slice(0, 4) : [];

// Curated quiz picks: quizzes for teams playing on the next match day first,
// then a mix of other categories — instead of an A-Z slice.
const playingTeams = new Set(
  (withinWeek ? upcomingDay!.fixtures : []).filter((f) => !f.tbd).flatMap((f) => [f.home, f.away]),
);
const playingToday = QUIZZES.filter((q) => !q.daily && q.teams?.some((t) => playingTeams.has(t)));
const fillers = QUIZZES.filter((q) => !q.daily && !playingToday.includes(q) && q.category !== 'Teams');
const featured = [...playingToday, ...fillers].slice(0, 6);
const featuredLabel = playingToday.length > 0 ? '🔥 Teams playing now' : 'Featured quizzes';

function fmtShortDate(d: string) {
  return new Date(d + 'T00:00:00Z').toLocaleDateString('en-US', {
    weekday: 'long', month: 'long', day: 'numeric', timeZone: 'UTC',
  });
}
const upcomingLabel = upcomingDay?.date === todayStr ? "Today's matches" : `Coming up · ${fmtShortDate(upcomingDay?.date ?? todayStr)}`;
---
<Base>
  <section class="rounded-3xl bg-gradient-to-br from-pitch to-pitch-dark px-6 py-12 text-center text-white">
    <h1 class="text-3xl font-extrabold sm:text-4xl">{SITE.name}</h1>
    <p class="mx-auto mt-3 max-w-md text-pitch-50/90 text-white/80">{SITE.tagline}</p>
    <p id="streak-banner" class="mx-auto mt-2 hidden text-sm font-semibold text-gold"></p>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      {daily && (
        <a href={`/quiz/${daily.slug}/1/`} class="inline-block rounded-xl bg-gold px-6 py-3 font-bold text-slate-900 hover:brightness-105">
          🔥 Play today's quiz →
        </a>
      )}
      <a href="/game/mystery-player/" class="inline-block rounded-xl bg-white px-6 py-3 font-bold text-pitch-dark hover:brightness-95">
        🕵️ Mystery Player →
      </a>
      <a href="/predict/" class="inline-block rounded-xl bg-white/15 px-6 py-3 font-bold text-white hover:bg-white/25">
        🗺️ Predict the World Cup →
      </a>
    </div>
  </section>

  <section class="mt-8 grid gap-3 sm:grid-cols-3">
    <a href="/game/mystery-player/" class="rounded-xl border border-gold bg-white p-4 hover:border-pitch">
      <div class="text-2xl">🕵️</div>
      <p class="mt-1 font-semibold">Mystery Player <span class="ml-1 rounded bg-gold px-1.5 py-0.5 text-[10px] font-bold text-slate-900">NEW</span></p>
      <p class="text-sm text-slate-500">Guess the hidden World Cup star in 6 tries. New player daily.</p>
    </a>
    <a href="/predict/" class="rounded-xl border border-slate-200 bg-white p-4 hover:border-pitch">
      <div class="text-2xl">⚽</div>
      <p class="mt-1 font-semibold">Predict all 104 matches</p>
      <p class="text-sm text-slate-500">Call every fixture, see how the world votes.</p>
    </a>
    <a href="/predict/bracket/" class="rounded-xl border border-slate-200 bg-white p-4 hover:border-pitch">
      <div class="text-2xl">🗺️</div>
      <p class="mt-1 font-semibold">Build your bracket</p>
      <p class="text-sm text-slate-500">Fill the knockouts, crown your champion.</p>
    </a>
    <a href="/predict/champion/" class="rounded-xl border border-slate-200 bg-white p-4 hover:border-pitch">
      <div class="text-2xl">🏆</div>
      <p class="mt-1 font-semibold">Pick the winner</p>
      <p class="text-sm text-slate-500">Who lifts the trophy in 2026?</p>
    </a>
  </section>

  {upcomingFixtures.length > 0 && (
    <section class="mt-8">
      <div class="flex items-center justify-between">
        <h2 class="text-xl font-bold">{upcomingLabel}</h2>
        <a href="/predict/" class="text-sm font-medium text-pitch hover:underline">All →</a>
      </div>
      <div class="mt-3 grid gap-2">
        {upcomingFixtures.map((f) => (
          <a href={fixtureUrl(f)} class="flex items-center gap-3 rounded-xl border border-slate-200 bg-white p-3 hover:border-pitch">
            <span class="w-14 shrink-0 text-xs font-medium text-slate-400">
              {f.round === 'group' ? `Grp ${f.group}` : ROUND_LABELS[f.round]}
            </span>
            <span class="flex-1 text-right text-sm font-semibold">{f.home}</span>
            <span class="shrink-0 rounded bg-slate-100 px-2 py-0.5 text-xs font-bold text-slate-500">v</span>
            <span class="flex-1 text-left text-sm font-semibold">{f.away}</span>
            <span class="shrink-0 text-xs font-medium text-pitch">Predict →</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <AdSlot label="Top ad" />

  <section class="mt-8">
    <h2 class="text-xl font-bold">{featuredLabel}</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      {featured.map((quiz) => <QuizCard quiz={quiz} />)}
    </div>
  </section>

  <Leaderboard />

  <script is:inline>
    try {
      const s = JSON.parse(localStorage.getItem('wsq:streak') || 'null');
      if (s && s.count > 0) {
        const today = new Date().toISOString().slice(0, 10);
        const yest = new Date(Date.now() - 864e5).toISOString().slice(0, 10);
        if (s.lastDate === today || s.lastDate === yest) {
          const el = document.getElementById('streak-banner');
          el.textContent = `🔥 ${s.count}-day quiz streak — keep it alive!`;
          el.classList.remove('hidden');
        }
      }
    } catch {}
  </script>

  <section class="mt-10">
    <h2 class="text-xl font-bold">Browse by sport</h2>
    <div class="mt-4 grid gap-3 sm:grid-cols-2">
      {SPORTS.map((sport) => (
        <a href={`/${sport.id}/`} class="flex items-center gap-3 rounded-xl border border-slate-200 bg-white p-4 hover:border-pitch">
          <span class="text-2xl">{sport.emoji}</span>
          <span class="font-semibold">{sport.name}</span>
        </a>
      ))}
    </div>
  </section>
</Base>
