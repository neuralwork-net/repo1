---
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';
import QuizCard from '../components/QuizCard.astro';
import { SPORTS } from '../data/sports';
import { QUIZZES, dailyQuiz } from '../lib/quizzes';
import { SITE } from '../lib/site';

const daily = dailyQuiz();
const featured = QUIZZES.slice(0, 6);
---
<Base>
  <section class="rounded-3xl bg-gradient-to-br from-pitch to-pitch-dark px-6 py-12 text-center text-white">
    <h1 class="text-3xl font-extrabold sm:text-4xl">{SITE.name}</h1>
    <p class="mx-auto mt-3 max-w-md text-pitch-50/90 text-white/80">{SITE.tagline}</p>
    {daily && (
      <a href={`/quiz/${daily.slug}/1/`} class="mt-6 inline-block rounded-xl bg-gold px-6 py-3 font-bold text-slate-900 hover:brightness-105">
        🔥 Play today's quiz →
      </a>
    )}
  </section>

  <AdSlot label="Top ad" />

  <section class="mt-8">
    <h2 class="text-xl font-bold">Featured quizzes</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      {featured.map((quiz) => <QuizCard quiz={quiz} />)}
    </div>
  </section>

  <section class="mt-10">
    <h2 class="text-xl font-bold">Browse by sport</h2>
    <div class="mt-4 grid gap-3 sm:grid-cols-2">
      {SPORTS.map((sport) => (
        <a href={`/${sport.id}/`} class="flex items-center gap-3 rounded-xl border border-slate-200 bg-white p-4 hover:border-pitch">
          <span class="text-2xl">{sport.emoji}</span>
          <span class="font-semibold">{sport.name}</span>
        </a>
      ))}
    </div>
  </section>
</Base>
