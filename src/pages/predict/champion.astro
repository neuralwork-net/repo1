---
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/AdSlot.astro';
import PollWidget from '../../components/PollWidget.astro';
import EmailCapture from '../../components/EmailCapture.astro';
import { FIXTURES } from '../../lib/predictions';
import { SITE } from '../../lib/site';

// The 48 qualified nations = every distinct team appearing in the group stage.
const teams = [
  ...new Set(
    FIXTURES.filter((f) => f.round === 'group').flatMap((f) => [f.home, f.away]),
  ),
].sort((a, b) => a.localeCompare(b));

const options = teams.map((t) => ({ value: t, label: t }));
const shareUrl = `${SITE.url}/predict/champion/`;
---
<Base
  title="Who will win the World Cup 2026?"
  description="Pick your World Cup 2026 champion from all 48 qualified nations and see who the world is backing to lift the trophy."
>
  <a href="/predict/" class="text-sm text-slate-400 hover:text-pitch">← All predictions</a>
  <h1 class="mt-3 text-2xl font-extrabold">🏆 Who lifts the trophy?</h1>
  <p class="mt-1 text-slate-600">Pick your World Cup 2026 champion. One vote — choose wisely.</p>

  <AdSlot label="Top ad" />

  <PollWidget poll="champion-2026" options={options} />

  <AdSlot label="After-pick ad" />

  <div class="mt-6 grid gap-2">
    <p class="text-center text-sm font-medium text-slate-600">Who are your friends backing? 👇</p>
    <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
      <a id="sh-wa" target="_blank" rel="noopener" class="rounded-lg bg-green-600 px-3 py-2 text-center text-sm font-semibold text-white">WhatsApp</a>
      <a id="sh-x" target="_blank" rel="noopener" class="rounded-lg bg-slate-900 px-3 py-2 text-center text-sm font-semibold text-white">X</a>
      <a id="sh-tg" target="_blank" rel="noopener" class="rounded-lg bg-sky-500 px-3 py-2 text-center text-sm font-semibold text-white">Telegram</a>
      <a id="sh-fb" target="_blank" rel="noopener" class="rounded-lg bg-blue-600 px-3 py-2 text-center text-sm font-semibold text-white">Facebook</a>
    </div>
  </div>

  <EmailCapture />

  <script is:inline define:vars={{ shareUrl }}>
    const text = `I picked my World Cup 2026 champion 🏆 Who's yours?`;
    const u = encodeURIComponent(shareUrl);
    const t = encodeURIComponent(text);
    document.getElementById('sh-wa').href = `https://wa.me/?text=${t}%20${u}`;
    document.getElementById('sh-x').href = `https://twitter.com/intent/tweet?text=${t}&url=${u}`;
    document.getElementById('sh-tg').href = `https://t.me/share/url?url=${u}&text=${t}`;
    document.getElementById('sh-fb').href = `https://www.facebook.com/sharer/sharer.php?u=${u}`;
  </script>
</Base>
