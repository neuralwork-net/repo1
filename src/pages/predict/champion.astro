---
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/AdSlot.astro';
import PollWidget from '../../components/PollWidget.astro';
import EmailCapture from '../../components/EmailCapture.astro';
import ShareBar from '../../components/ShareBar.astro';
import { FIXTURES } from '../../lib/predictions';
import { SITE } from '../../lib/site';
import { globalStats, formatCompact } from '../../lib/social-proof';
import { FLAGS } from '../../lib/share';

// The 48 qualified nations = every distinct team appearing in the group stage.
const teams = [
  ...new Set(
    FIXTURES.filter((f) => f.round === 'group').flatMap((f) => [f.home, f.away]),
  ),
].sort((a, b) => a.localeCompare(b));

const options = teams.map((t) => ({ value: t, label: t }));
const shareUrl = `${SITE.url}/predict/champion/`;
const today = new Date().toLocaleDateString('en-CA');
const stats = globalStats(today);
// Bias the seeded crowd toward a believable favourite that's actually qualified.
const favor = ['France', 'Spain', 'Argentina', 'Brazil', 'England'].find((t) => teams.includes(t)) ?? null;
---
<Base
  title="Who will win the World Cup 2026?"
  description="Pick your World Cup 2026 champion from all 48 qualified nations and see who the world is backing to lift the trophy."
>
  <a href="/predict/" class="text-sm text-slate-400 hover:text-pitch">← All predictions</a>
  <h1 class="mt-3 text-2xl font-extrabold">🏆 Who lifts the trophy?</h1>
  <p class="mt-1 text-slate-600">Pick your World Cup 2026 champion. One vote — choose wisely.</p>

  <p id="challenge-banner" class="mt-4 hidden rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-center text-sm font-semibold text-amber-800"></p>

  <p class="mt-4 rounded-xl border border-slate-200 bg-white px-4 py-3 text-center text-sm font-medium text-slate-600">
    🌍 <span class="font-bold text-pitch">{formatCompact(stats.predictions)}</span> predictions from
    <span class="font-bold text-pitch">{stats.countries}</span> countries so far
  </p>

  <AdSlot label="Top ad" />

  <PollWidget poll="champion-2026" options={options} favor={favor} />

  <AdSlot label="After-pick ad" />

  <ShareBar id="share-champion" prompt="Who are your friends backing? 👇" />

  <EmailCapture />

  <script is:inline define:vars={{ shareUrl, flags: FLAGS }}>
    const team = localStorage.getItem('wsq:voted:champion-2026');
    const named = team && flags[team] ? flags[team] + ' ' + team : team;
    const text = team
      ? `I'm backing ${named} to win the World Cup 2026 🏆 Who's your pick?`
      : `I picked my World Cup 2026 champion 🏆 Who's yours?`;
    const url = team ? shareUrl + '?p=' + encodeURIComponent(team) : shareUrl;
    (window.__wsqShareQueue = window.__wsqShareQueue || []).push([
      '#share-champion',
      { text, url, contentType: 'champion_pick', itemId: team || '' },
    ]);

    // Challenge banner from a shared link (?p=Team), only for known nations.
    const friendPick = new URLSearchParams(location.search).get('p');
    if (friendPick && flags[friendPick]) {
      const banner = document.getElementById('challenge-banner');
      if (banner) {
        banner.textContent = `👀 A friend is backing ${flags[friendPick]} ${friendPick} 🏆 — who's yours?`;
        banner.classList.remove('hidden');
      }
    }
  </script>
</Base>
