---
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/AdSlot.astro';
import { knockoutFixtures } from '../../lib/predictions';
import { SITE } from '../../lib/site';
import { globalStats, formatCompact } from '../../lib/social-proof';
import ShareBar from '../../components/ShareBar.astro';
import { FLAGS } from '../../lib/share';

// Feed the knockout structure to the client; it builds an interactive bracket.
const ko = knockoutFixtures().map((f) => ({
  match: f.match,
  round: f.round,
  home: f.home,
  away: f.away,
}));
const shareUrl = `${SITE.url}/predict/bracket/`;
const stats = globalStats(new Date().toLocaleDateString('en-CA'));
---
<Base
  title="Build your World Cup 2026 bracket"
  description="Fill in your World Cup 2026 knockout bracket from the Round of 32 to the final, pick your champion, and share it with friends."
>
  <a href="/predict/" class="text-sm text-slate-400 hover:text-pitch">← All predictions</a>
  <h1 class="mt-3 text-2xl font-extrabold">🗺️ Build your bracket</h1>
  <p class="mt-1 text-slate-600">Tap a team to send it through. Your champion appears up top.</p>

  <div class="mt-4 rounded-2xl bg-gradient-to-br from-pitch to-pitch-dark p-5 text-center text-white">
    <p class="text-xs uppercase tracking-wide text-white/70">Your champion</p>
    <p id="champ" class="mt-1 text-2xl font-extrabold">— pick the final —</p>
    <button id="reset" class="mt-3 rounded-lg bg-white/15 px-4 py-1.5 text-sm font-semibold hover:bg-white/25">Reset bracket</button>
  </div>

  <p class="mt-3 text-center text-xs font-medium text-slate-400">
    🌍 Joined by {formatCompact(stats.voters)} fans from {stats.countries} countries
  </p>

  <AdSlot label="Top ad" />

  <p id="challenge-banner" class="mb-4 hidden rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-center text-sm font-semibold text-amber-800"></p>

  <div id="groups-banner" class="hidden"></div>

  <div class="-mx-4 overflow-x-auto px-4">
    <div id="bracket" class="flex min-w-max gap-4 pb-4"></div>
  </div>

  <ShareBar id="share-bracket" prompt="Share your bracket 👇" />

  <AdSlot label="Bottom ad" />

  <script is:inline define:vars={{ ko, shareUrl, flags: FLAGS }}>
    const KEY = 'wsq:bracket';
    const GROUPS_KEY = 'wsq:groups';
    const ROUNDS = [
      ['r32', 'Round of 32'],
      ['r16', 'Round of 16'],
      ['qf', 'Quarter-finals'],
      ['sf', 'Semi-finals'],
      ['final', 'Final'],
    ];
    const byMatch = Object.fromEntries(ko.map((m) => [m.match, m]));
    let picks = {};
    let groups = {};
    try { picks = JSON.parse(localStorage.getItem(KEY) || '{}'); } catch {}
    try { groups = JSON.parse(localStorage.getItem(GROUPS_KEY) || '{}'); } catch {}

    const refWinner = (s) => (s.match(/^Winner Match (\d+)$/) || [])[1];
    const refRunner = (s) => (s.match(/^Runner-up Match (\d+)$/) || [])[1];

    // Resolve a slot label to the team/descriptor currently occupying it.
    function resolve(label, seen = new Set()) {
      // Resolve group-stage qualifiers from wsq:groups picks
      const gW = label.match(/^Group ([A-L]) winners$/);
      if (gW) return groups[gW[1]]?.w || label;
      const gR = label.match(/^Group ([A-L]) runners-up$/);
      if (gR) return groups[gR[1]]?.r || label;

      const w = refWinner(label);
      if (w) {
        if (seen.has('w' + w)) return label;
        seen.add('w' + w);
        return picks[w] ? picks[w] : label;
      }
      const r = refRunner(label);
      if (r) {
        if (!picks[r]) return label;
        const m = byMatch[r];
        const home = resolve(m.home, seen);
        const away = resolve(m.away, seen);
        return picks[r] === home ? away : home; // the one that didn't win
      }
      return label;
    }

    function pick(match, slotLabel) {
      const team = resolve(slotLabel);
      if (team === slotLabel) return; // slot not yet resolved
      picks[match] = team;
      localStorage.setItem(KEY, JSON.stringify(picks));
      render();
      if (window.gtag) window.gtag('event', 'bracket_pick', { match });
    }

    function render() {
      // Re-read groups on each render in case user just came from groups page
      try { groups = JSON.parse(localStorage.getItem(GROUPS_KEY) || '{}'); } catch {}

      const groupsDone = Object.keys(groups).filter((g) => groups[g]?.w && groups[g]?.r).length;
      const banner = document.getElementById('groups-banner');
      if (groupsDone < 12) {
        banner.className = 'mb-4 flex items-center justify-between rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm';
        banner.innerHTML = '<span class="text-amber-800">Pick your group qualifiers to see team names in the bracket.</span>' +
          '<a href="/predict/groups/" class="ml-3 shrink-0 font-semibold text-pitch hover:underline">Pick groups →</a>';
      } else {
        banner.className = 'hidden';
      }

      const root = document.getElementById('bracket');
      root.innerHTML = '';
      for (const [round, label] of ROUNDS) {
        const col = document.createElement('div');
        col.className = 'flex w-44 flex-col justify-around gap-3';
        const h = document.createElement('p');
        h.className = 'text-center text-xs font-bold uppercase tracking-wide text-slate-400';
        h.textContent = label;
        col.appendChild(h);
        ko.filter((m) => m.round === round).forEach((m) => {
          const box = document.createElement('div');
          box.className = 'rounded-lg border border-slate-200 bg-white text-sm';
          [m.home, m.away].forEach((slot) => {
            const team = resolve(slot);
            const decided = team !== slot;
            const chosen = picks[m.match] === team && decided;
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className =
              'block w-full truncate px-3 py-2 text-left ' +
              (chosen ? 'bg-pitch/10 font-bold text-pitch' : 'hover:bg-slate-50') +
              (decided ? '' : ' text-slate-400 italic');
            btn.textContent = team;
            btn.title = team;
            btn.addEventListener('click', () => pick(m.match, slot));
            box.appendChild(btn);
            if (slot === m.home) {
              const hr = document.createElement('div');
              hr.className = 'border-t border-slate-100';
              box.appendChild(hr);
            }
          });
          col.appendChild(box);
        });
        root.appendChild(col);
      }
      const champ = picks[104];
      document.getElementById('champ').textContent = champ || '— pick the final —';
      updateShare(champ);
    }

    function updateShare(champ) {
      const named = champ && flags[champ] ? flags[champ] + ' ' + champ : champ;
      const text = champ
        ? `I've got ${named} winning the World Cup 2026 🏆 Build your bracket:`
        : `I'm building my World Cup 2026 bracket 🗺️ Make yours:`;
      const url = champ ? shareUrl + '?champ=' + encodeURIComponent(champ) : shareUrl;
      (window.__wsqShareQueue = window.__wsqShareQueue || []).push([
        '#share-bracket',
        { text, url, contentType: 'bracket', itemId: champ || '' },
      ]);
    }

    document.getElementById('reset').addEventListener('click', () => {
      picks = {};
      localStorage.removeItem(KEY);
      render();
    });

    // Challenge banner from a shared bracket link (?champ=Team), known nations only.
    const friendChamp = new URLSearchParams(location.search).get('champ');
    if (friendChamp && flags[friendChamp]) {
      const banner = document.getElementById('challenge-banner');
      if (banner) {
        banner.textContent = `👀 A friend has ${flags[friendChamp]} ${friendChamp} winning it all — build your own bracket.`;
        banner.classList.remove('hidden');
      }
    }

    render();
  </script>
</Base>
