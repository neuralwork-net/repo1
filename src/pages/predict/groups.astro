---
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/AdSlot.astro';
import { fixturesByGroup, groupLetters } from '../../lib/predictions';

const byGroup = fixturesByGroup();
const letters = groupLetters();

// Build { A: ['Mexico', 'South Africa', ...], ... }
const groupData: Record<string, string[]> = {};
for (const g of letters) {
  const teams = new Set<string>();
  for (const f of byGroup[g]) {
    teams.add(f.home);
    teams.add(f.away);
  }
  groupData[g] = [...teams];
}
---
<Base
  title="Pick your group qualifiers – World Cup 2026"
  description="Pick the winner and runner-up from each of the 12 World Cup 2026 groups, then build your knockout bracket."
>
  <a href="/predict/" class="text-sm text-slate-400 hover:text-pitch">← All predictions</a>
  <h1 class="mt-3 text-2xl font-extrabold">🎯 Pick your group qualifiers</h1>
  <p class="mt-1 text-slate-600">Tap a team once for 1st, again for 2nd. Fill all 12 groups to unlock your bracket.</p>

  <div id="progress-bar" class="mt-4 h-2 rounded-full bg-slate-100">
    <div id="progress-fill" class="h-2 rounded-full bg-pitch transition-all" style="width:0%"></div>
  </div>
  <p id="progress-label" class="mt-1 text-xs text-slate-400">0 / 12 groups done</p>

  <AdSlot label="Top ad" />

  <div id="groups" class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3"></div>

  <div class="mt-6 flex flex-wrap gap-3">
    <a
      id="bracket-btn"
      href="/predict/bracket/"
      class="rounded-xl px-6 py-3 font-bold transition-colors"
      style="pointer-events:none"
    >🗺️ Build bracket →</a>
    <button id="reset-all" class="rounded-xl border border-slate-200 px-4 py-3 text-sm font-medium text-slate-500 hover:bg-slate-50">
      Reset all
    </button>
  </div>

  <AdSlot label="Bottom ad" />

  <script is:inline define:vars={{ groupData }}>
    const KEY = 'wsq:groups';
    const letters = Object.keys(groupData).sort();
    let picks = {};
    try { picks = JSON.parse(localStorage.getItem(KEY) || '{}'); } catch {}

    function save() {
      localStorage.setItem(KEY, JSON.stringify(picks));
    }

    function tapTeam(g, team) {
      const p = picks[g] || {};
      if (p.w === team) {
        // clicking winner → clear both
        delete picks[g];
      } else if (p.r === team) {
        // clicking runner-up → clear runner-up only
        picks[g] = { w: p.w };
      } else if (!p.w) {
        // nothing set → set winner
        picks[g] = { w: team };
      } else if (!p.r) {
        // winner set, no runner-up → set runner-up
        picks[g] = { w: p.w, r: team };
      } else {
        // both set, tapping a new team → replace runner-up
        picks[g] = { w: p.w, r: team };
      }
      save();
      render();
    }

    function render() {
      const root = document.getElementById('groups');
      root.innerHTML = '';
      let done = 0;

      for (const g of letters) {
        const teams = groupData[g];
        const p = picks[g] || {};
        const isDone = p.w && p.r;
        if (isDone) done++;

        const card = document.createElement('div');
        card.className = 'rounded-2xl border bg-white p-4 ' + (isDone ? 'border-pitch/40' : 'border-slate-200');

        const header = document.createElement('p');
        header.className = 'mb-3 text-xs font-bold uppercase tracking-widest ' + (isDone ? 'text-pitch' : 'text-slate-400');
        header.textContent = 'Group ' + g;
        card.appendChild(header);

        const grid = document.createElement('div');
        grid.className = 'grid grid-cols-2 gap-2';

        for (const team of teams) {
          const rank = p.w === team ? 1 : p.r === team ? 2 : 0;
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'relative flex items-center gap-1.5 rounded-lg border px-2 py-2 text-left text-sm font-medium transition-colors ' +
            (rank === 1 ? 'border-amber-400 bg-amber-50 text-amber-800' :
             rank === 2 ? 'border-slate-400 bg-slate-100 text-slate-700' :
             'border-slate-200 bg-white text-slate-700 hover:bg-slate-50');

          if (rank > 0) {
            const badge = document.createElement('span');
            badge.className = 'shrink-0 rounded px-1 py-0.5 text-[10px] font-bold ' +
              (rank === 1 ? 'bg-amber-400 text-white' : 'bg-slate-400 text-white');
            badge.textContent = rank === 1 ? '1st' : '2nd';
            btn.appendChild(badge);
          }

          const label = document.createElement('span');
          label.className = 'truncate';
          label.textContent = team;
          label.title = team;
          btn.appendChild(label);

          btn.addEventListener('click', () => tapTeam(g, team));
          grid.appendChild(btn);
        }

        card.appendChild(grid);
        root.appendChild(card);
      }

      // Progress
      const pct = Math.round((done / 12) * 100);
      document.getElementById('progress-fill').style.width = pct + '%';
      document.getElementById('progress-label').textContent = done + ' / 12 groups done';

      // Bracket button
      const bracketBtn = document.getElementById('bracket-btn');
      if (done === 12) {
        bracketBtn.className = 'rounded-xl bg-pitch px-6 py-3 font-bold text-white hover:brightness-105 transition-colors';
        bracketBtn.style.pointerEvents = 'auto';
      } else {
        bracketBtn.className = 'rounded-xl bg-slate-200 px-6 py-3 font-bold text-slate-400 transition-colors cursor-not-allowed';
        bracketBtn.style.pointerEvents = 'none';
      }
    }

    document.getElementById('reset-all').addEventListener('click', () => {
      picks = {};
      localStorage.removeItem(KEY);
      render();
    });

    render();
  </script>
</Base>
