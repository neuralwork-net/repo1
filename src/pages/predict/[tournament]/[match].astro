---
import Base from '../../../layouts/Base.astro';
import AdSlot from '../../../components/AdSlot.astro';
import PollWidget from '../../../components/PollWidget.astro';
import EmailCapture from '../../../components/EmailCapture.astro';
import ShareBar from '../../../components/ShareBar.astro';
import { FIXTURES, getFixtureByMatchSlug, fixtureUrl, ROUND_LABELS, isFinished, outcome, VENUE_INFO } from '../../../lib/predictions';
import { SITE } from '../../../lib/site';
import { fixtureSlug } from '../../../lib/predictions';
import { quizzesForTeams } from '../../../lib/quizzes';
import { buildMatchContent, matchDescription } from '../../../lib/match-content';
import { predictionShareText, flag } from '../../../lib/share';

export function getStaticPaths() {
  return FIXTURES.map((f) => ({
    params: { tournament: 'world-cup-2026', match: fixtureSlug(f) },
  }));
}

const { match } = Astro.params;
const f = getFixtureByMatchSlug(match!)!;
const idx = FIXTURES.findIndex((x) => x.id === f.id);
const prev = FIXTURES[idx - 1];
const next = FIXTURES[idx + 1];

const roundLabel = ROUND_LABELS[f.round];
const heading = f.round === 'group' ? `Group ${f.group}` : roundLabel;
const finished = isFinished(f);
const result = outcome(f);

const dateLabel = new Date(f.kickoff + 'T00:00:00Z').toLocaleDateString('en-US', {
  weekday: 'long',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

const options =
  f.round === 'group'
    ? [
        { value: 'home', label: `${f.home} win` },
        { value: 'draw', label: 'Draw' },
        { value: 'away', label: `${f.away} win` },
      ]
    : [
        { value: 'home', label: f.home },
        { value: 'away', label: f.away },
      ];

const title = f.tbd
  ? `${heading}: ${f.home} v ${f.away}`
  : finished
    ? `${f.home} vs ${f.away} Result & Predictions — FIFA World Cup 2026`
    : `${f.home} vs ${f.away} Prediction — FIFA World Cup 2026`;
const description = matchDescription(f);
const content = buildMatchContent(f);
const ogImage = f.tbd ? `${SITE.url}/og.png` : `${SITE.url}/og/match-${fixtureSlug(f)}.png`;
const shareUrl = `${SITE.url}${fixtureUrl(f)}`;
const relatedQuizzes = f.tbd ? [] : quizzesForTeams([f.home, f.away]);
// Precompute the personalized share text for each possible pick (pure helper);
// the inline script picks the right one from the user's stored vote.
const shareTexts = {
  home: predictionShareText(f.home, f.away, 'home'),
  away: predictionShareText(f.home, f.away, 'away'),
  draw: predictionShareText(f.home, f.away, 'draw'),
  none: predictionShareText(f.home, f.away, null),
};
// Map for the challenge banner: pick value -> team name (draw handled inline).
const homeFlag = flag(f.home);
const awayFlag = flag(f.away);

const breadcrumbs = [
  { label: 'Predict', href: '/predict/' },
  { label: f.tbd ? `${f.home} vs ${f.away}` : `${f.home} vs ${f.away}`, href: '' },
];

const venueInfo = VENUE_INFO[f.venue];
const teamPerformers = [
  { '@type': 'SportsTeam', name: f.home },
  { '@type': 'SportsTeam', name: f.away },
];
const sportsEventSchema = f.tbd ? null : {
  '@context': 'https://schema.org',
  '@type': 'SportsEvent',
  name: `${f.home} vs ${f.away}`,
  description,
  startDate: f.kickoff,
  endDate: f.kickoff,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  image: [ogImage],
  location: {
    '@type': 'Place',
    name: f.venue,
    address: {
      '@type': 'PostalAddress',
      ...(venueInfo ? { addressLocality: venueInfo.city } : {}),
      addressCountry: venueInfo?.country ?? 'US',
    },
  },
  sport: 'Football',
  homeTeam: { '@type': 'SportsTeam', name: f.home },
  awayTeam: { '@type': 'SportsTeam', name: f.away },
  competitor: teamPerformers,
  performer: teamPerformers,
  organizer: { '@type': 'Organization', name: 'FIFA', url: 'https://www.fifa.com/' },
  offers: {
    '@type': 'Offer',
    url: shareUrl,
    price: '0',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    validFrom: f.kickoff,
  },
  url: shareUrl,
};
---
<Base title={title} description={description} image={ogImage} breadcrumbs={breadcrumbs}>
  {sportsEventSchema && <script slot="head" type="application/ld+json" set:html={JSON.stringify(sportsEventSchema)} />}
  <a href="/predict/" class="text-sm text-slate-400 hover:text-pitch">← All predictions</a>

  <div class="mt-3 flex items-center justify-between text-xs font-medium text-slate-500">
    <span>Match {f.match} · {heading}</span>
    <span>{dateLabel}</span>
  </div>

  <div class="mt-3 rounded-2xl border border-slate-200 bg-white p-5 text-center">
    <div class="flex items-center justify-center gap-4 text-lg font-bold sm:text-xl">
      <span class="flex-1 text-right">{f.home}</span>
      <span class="text-slate-300">{finished ? `${f.homeScore}–${f.awayScore}` : 'v'}</span>
      <span class="flex-1 text-left">{f.away}</span>
    </div>
    <p class="mt-2 text-xs text-slate-400">📍 {f.venue}</p>
    {finished && (
      <p class="mt-1 text-sm font-semibold text-pitch">
        Full time{result === 'draw' ? ' — draw' : ` — ${result === 'home' ? f.home : f.away} won`}
      </p>
    )}
  </div>

  <AdSlot label="Top ad" />

  {content && (
    <section class="mt-5">
      <h1 class="text-lg font-bold text-slate-900">{content.question}</h1>
      <p class="mt-2 text-sm leading-relaxed text-slate-600">{content.answer}</p>
    </section>
  )}

  {f.tbd ? (
    <div class="mt-5 rounded-xl border border-dashed border-slate-300 bg-white/60 p-6 text-center text-sm text-slate-500">
      Teams to be decided. Check back once the bracket fills in — then make your call.
    </div>
  ) : (
    <>
      <p id="challenge-banner" class="mt-5 hidden rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-center text-sm font-semibold text-amber-800"></p>
      <p class="mt-5 text-lg font-bold text-slate-900">
        {finished ? 'How the world predicted it' : 'Who wins? Make your prediction'}
      </p>
      <PollWidget poll={f.id} options={options} correct={finished ? result : null} favor={finished ? result : null} />
    </>
  )}

  {content && (
    <section class="mt-6">
      <h2 class="text-sm font-semibold text-slate-600">Match facts</h2>
      <dl class="mt-2 divide-y divide-slate-100 rounded-xl border border-slate-200 bg-white text-sm">
        {content.facts.map((row) => (
          <div class="flex gap-3 px-4 py-2.5">
            <dt class="w-28 shrink-0 font-medium text-slate-400">{row.label}</dt>
            <dd class="text-slate-700">{row.value}</dd>
          </div>
        ))}
      </dl>
    </section>
  )}

  {content && content.teamNotes.length > 0 && (
    <section class="mt-6">
      <h2 class="text-sm font-semibold text-slate-600">Know the teams</h2>
      <div class="mt-2 grid gap-2">
        {content.teamNotes.map((tn) => (
          <div class="rounded-xl border border-slate-200 bg-white p-4">
            <p class="text-sm font-bold text-slate-900">{tn.team}</p>
            <p class="mt-1 text-sm leading-relaxed text-slate-600">{tn.note}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  <AdSlot label="After-pick ad" />

  <div class="mt-6 space-y-6">
    {!f.tbd && <ShareBar id="share-match" />}

    <EmailCapture />

    {relatedQuizzes.length > 0 && (
      <section>
        <p class="mb-2 text-sm font-semibold text-slate-600">🎯 Test your knowledge</p>
        <div class="grid gap-2">
          {relatedQuizzes.map((q) => (
            <a href={`/quiz/${q.slug}/`} class="flex items-center gap-3 rounded-xl border border-slate-200 bg-white p-3 hover:border-pitch">
              <span class="text-2xl">{q.emoji ?? '⚽'}</span>
              <div>
                <p class="text-sm font-semibold">{q.title}</p>
                <p class="text-xs text-slate-400">{q.questions.length} questions</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>

  <nav class="mt-6 flex justify-between text-sm font-semibold text-pitch">
    {prev ? <a href={fixtureUrl(prev)}>← Match {prev.match}</a> : <span></span>}
    {next ? <a href={fixtureUrl(next)}>Match {next.match} →</a> : <span></span>}
  </nav>

  {!f.tbd && (
    <script is:inline define:vars={{ fid: f.id, shareUrl, ogImage, shareTexts, home: f.home, away: f.away, homeFlag, awayFlag }}>
      const pick = localStorage.getItem('wsq:voted:' + fid);
      const text = pick === 'home' ? shareTexts.home
        : pick === 'away' ? shareTexts.away
        : pick === 'draw' ? shareTexts.draw
        : shareTexts.none;
      const url = pick ? shareUrl + '?p=' + pick : shareUrl;
      (window.__wsqShareQueue = window.__wsqShareQueue || []).push([
        '#share-match',
        { text, url, image: ogImage, contentType: 'match_prediction', itemId: fid },
      ]);

      // Challenge banner: if arriving from a shared link (?p=), show the sender's call.
      const params = new URLSearchParams(location.search);
      const friendPick = params.get('p');
      if (friendPick === 'home' || friendPick === 'away' || friendPick === 'draw') {
        const who = friendPick === 'home' ? (homeFlag ? homeFlag + ' ' + home : home)
          : friendPick === 'away' ? (awayFlag ? awayFlag + ' ' + away : away)
          : 'a draw';
        const banner = document.getElementById('challenge-banner');
        if (banner) {
          banner.textContent = friendPick === 'draw'
            ? '👀 A friend is calling this a draw — make your call.'
            : '👀 A friend is backing ' + who + ' — make your call.';
          banner.classList.remove('hidden');
        }
      }
    </script>
  )}
</Base>
