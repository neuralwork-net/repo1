---
import Base from '../../../layouts/Base.astro';
import AdSlot from '../../../components/AdSlot.astro';
import EmailCapture from '../../../components/EmailCapture.astro';
import { SITE } from '../../../lib/site';
import players from '../../../data/players.json';

const breadcrumbs = [{ label: 'Mystery Player', href: '' }];
const description = `Guess the hidden World Cup 2026 player in 6 tries. A new mystery player every day — ${players.length} stars from all 48 nations. Free, no sign-up.`;
---
<Base
  title="Mystery Player — guess the World Cup star"
  description={description}
  image={`${SITE.url}/og/mystery-player.png`}
  breadcrumbs={breadcrumbs}
>
  <div class="text-center">
    <div class="text-5xl">🕵️</div>
    <h1 class="mt-3 text-2xl font-bold">Mystery Player <span id="puzzle-no" class="text-slate-400 font-semibold"></span></h1>
    <p class="mt-1 text-slate-500">Guess the World Cup 2026 player in 6 tries.</p>
    <p id="streak-line" class="mt-2 hidden text-sm font-bold text-amber-600"></p>
  </div>

  <!-- Guess input -->
  <div id="input-area" class="relative mx-auto mt-6 max-w-md">
    <input
      id="guess-input"
      type="text"
      autocomplete="off"
      placeholder="Type a player's name…"
      class="w-full rounded-xl border border-slate-300 px-4 py-3 text-base focus:border-pitch focus:outline-none"
    />
    <ul id="ac-list" class="absolute z-10 mt-1 hidden max-h-64 w-full overflow-auto rounded-xl border border-slate-200 bg-white shadow-lg"></ul>
    <p id="guesses-left" class="mt-2 text-center text-xs font-medium text-slate-400"></p>
  </div>

  <!-- Board -->
  <div id="board" class="mt-5 grid gap-2"></div>

  <!-- Legend -->
  <div class="mt-4 flex flex-wrap justify-center gap-x-4 gap-y-1 text-xs text-slate-500">
    <span><span class="font-semibold text-pitch">🟩 exact</span></span>
    <span>🟨 close (same confederation / ±2 yrs / ±3 shirt)</span>
    <span>↑↓ target is higher / lower</span>
  </div>

  <!-- Result panel -->
  <div id="result" class="mt-6 hidden rounded-2xl border border-slate-200 bg-white p-5 text-center">
    <p id="result-headline" class="text-xl font-extrabold"></p>
    <p id="result-answer" class="mt-1 text-slate-600"></p>
    <p id="countdown" class="mt-2 text-sm text-slate-400"></p>

    <div class="mt-4 grid gap-2">
      <p class="text-sm font-medium text-slate-600">Challenge your friends 👇</p>
      <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
        <a id="sh-wa" target="_blank" rel="noopener" class="rounded-lg bg-green-600 px-3 py-2 text-center text-sm font-semibold text-white">WhatsApp</a>
        <a id="sh-x" target="_blank" rel="noopener" class="rounded-lg bg-slate-900 px-3 py-2 text-center text-sm font-semibold text-white">X</a>
        <a id="sh-tg" target="_blank" rel="noopener" class="rounded-lg bg-sky-500 px-3 py-2 text-center text-sm font-semibold text-white">Telegram</a>
        <button id="copy" class="rounded-lg border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">Copy result</button>
      </div>
    </div>

    <!-- Stats -->
    <div class="mt-5 border-t border-slate-100 pt-4">
      <div class="grid grid-cols-3 gap-2 text-center">
        <div><p id="st-played" class="text-xl font-extrabold text-pitch">0</p><p class="text-xs text-slate-400">Played</p></div>
        <div><p id="st-streak" class="text-xl font-extrabold text-pitch">0</p><p class="text-xs text-slate-400">Streak</p></div>
        <div><p id="st-max" class="text-xl font-extrabold text-pitch">0</p><p class="text-xs text-slate-400">Best streak</p></div>
      </div>
      <div id="dist" class="mt-3 grid gap-1 text-left"></div>
    </div>
  </div>

  <AdSlot label="Game ad" />
  <EmailCapture />

  <section class="mt-8 text-sm leading-relaxed text-slate-500">
    <h2 class="text-base font-bold text-slate-700">How to play</h2>
    <p class="mt-2">
      Every day there's one hidden World Cup 2026 player — the same for everyone.
      Type any player's name and we'll compare them to the mystery man: nationality
      (🟨 means same confederation), position, age, club league, and shirt number.
      Arrows tell you whether the target is older/younger or wears a higher/lower number.
      You have 6 guesses. Come back tomorrow for a new player and keep your streak alive!
    </p>
    <p class="mt-2">
      The pool covers {players.length} stars from all 48 qualified nations. Done guessing?
      Try a <a href="/football/" class="text-pitch underline">team quiz</a> or
      <a href="/predict/" class="text-pitch underline">predict today's matches</a>.
    </p>
  </section>
</Base>

<script>
  import playersData from '../../../data/players.json';
  import { pickDaily, compareGuess, puzzleNumber } from '../../../lib/mystery';
  import type { MysteryPlayer, Feedback, AttributeFeedback } from '../../../lib/mystery';

  const players = playersData as MysteryPlayer[];
  const MAX_GUESSES = 6;
  const today = new Date().toLocaleDateString('en-CA'); // YYYY-MM-DD local
  const answer = pickDaily(players, today);
  const puzzleNo = Math.max(1, puzzleNumber(today));
  const thisYear = new Date().getFullYear();
  const SITE_URL = 'https://worldsportsquiz.com/game/mystery-player/';

  const KEY = 'wsq:mystery';
  const STATS_KEY = 'wsq:mystery-stats';

  interface GameState { date: string; guesses: string[]; result: 'win' | 'lose' | null }

  function loadState(): GameState {
    try {
      const s = JSON.parse(localStorage.getItem(KEY) || 'null');
      if (s && s.date === today) return s;
    } catch {}
    return { date: today, guesses: [], result: null };
  }
  const state = loadState();
  const save = () => localStorage.setItem(KEY, JSON.stringify(state));

  const byId = new Map(players.map((p) => [p.id, p]));
  const norm = (s: string) =>
    s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');

  const $ = (id: string) => document.getElementById(id)!;
  $('puzzle-no').textContent = '#' + puzzleNo;

  const FLAG_NOTE: Record<string, string> = {
    green: 'bg-green-600 text-white',
    yellow: 'bg-amber-400 text-slate-900',
    gray: 'bg-slate-200 text-slate-600',
  };

  function chip(label: string, value: string, fb: AttributeFeedback, invertArrow = false) {
    let arrow = '';
    if (fb.arrow) {
      const dir = invertArrow ? (fb.arrow === 'up' ? 'down' : 'up') : fb.arrow;
      arrow = dir === 'up' ? ' ↑' : ' ↓';
    }
    return `<div class="rounded-lg px-1.5 py-1.5 text-center ${FLAG_NOTE[fb.color]}">
      <p class="text-[10px] uppercase opacity-70">${label}</p>
      <p class="truncate text-xs font-bold">${value}${arrow}</p>
    </div>`;
  }

  function renderRow(g: MysteryPlayer, fb: Feedback) {
    const row = document.createElement('div');
    row.className = 'rounded-xl border border-slate-200 bg-white p-2';
    row.innerHTML = `
      <p class="mb-1.5 px-1 text-sm font-bold ${fb.correct ? 'text-pitch' : 'text-slate-700'}">${fb.correct ? '🎯 ' : ''}${g.name}</p>
      <div class="grid grid-cols-5 gap-1.5">
        ${chip('Nation', g.nation, fb.nation)}
        ${chip('Pos', g.position, fb.position)}
        ${chip('Age', String(thisYear - g.birthYear), fb.age, true)}
        ${chip('League', g.league, fb.league)}
        ${chip('Shirt', '#' + g.shirt, fb.shirt)}
      </div>`;
    return row;
  }

  const board = $('board');
  function renderBoard() {
    board.innerHTML = '';
    for (const id of state.guesses) {
      const g = byId.get(id);
      if (g) board.appendChild(renderRow(g, compareGuess(g, answer)));
    }
    const left = MAX_GUESSES - state.guesses.length;
    $('guesses-left').textContent = state.result ? '' : `${left} guess${left === 1 ? '' : 'es'} left`;
  }

  // ---- Stats ----
  interface Stats { streak: number; maxStreak: number; lastWinDate: string; lastPlayedDate: string; played: number; dist: Record<string, number> }
  function loadStats(): Stats {
    try {
      const s = JSON.parse(localStorage.getItem(STATS_KEY) || 'null');
      if (s) return s;
    } catch {}
    return { streak: 0, maxStreak: 0, lastWinDate: '', lastPlayedDate: '', played: 0, dist: {} };
  }

  function finishGame(won: boolean) {
    const stats = loadStats();
    if (stats.lastPlayedDate !== today) {
      stats.played += 1;
      stats.lastPlayedDate = today;
      const yest = new Date(Date.now() - 864e5).toLocaleDateString('en-CA');
      if (won) {
        stats.streak = stats.lastWinDate === yest ? stats.streak + 1 : 1;
        stats.lastWinDate = today;
        stats.maxStreak = Math.max(stats.maxStreak, stats.streak);
        const n = String(state.guesses.length);
        stats.dist[n] = (stats.dist[n] || 0) + 1;
      } else {
        stats.streak = 0;
      }
      localStorage.setItem(STATS_KEY, JSON.stringify(stats));
    }

    // Feed the site-wide daily streak too (same routine as quiz results).
    try {
      const SKEY = 'wsq:streak';
      const yest = new Date(Date.now() - 864e5).toISOString().slice(0, 10);
      const utcToday = new Date().toISOString().slice(0, 10);
      const s = JSON.parse(localStorage.getItem(SKEY) || '{"count":0,"lastDate":""}');
      if (s.lastDate !== utcToday) {
        s.count = s.lastDate === yest ? s.count + 1 : 1;
        s.lastDate = utcToday;
        localStorage.setItem(SKEY, JSON.stringify(s));
      }
    } catch {}

    showResult(won, stats);
    const w = window as any;
    if (w.gtag) w.gtag('event', won ? 'mystery_win' : 'mystery_lose', { guesses: state.guesses.length, puzzle: puzzleNo });
  }

  function shareText(won: boolean): string {
    const rows = state.guesses
      .map((id) => {
        const g = byId.get(id)!;
        const fb = compareGuess(g, answer);
        const sq = (c: string) => (c === 'green' ? '🟩' : c === 'yellow' ? '🟨' : '⬜');
        return [fb.nation, fb.position, fb.age, fb.league, fb.shirt].map((f) => sq(f.color)).join('');
      })
      .join('\n');
    const score = won ? `${state.guesses.length}/${MAX_GUESSES}` : `X/${MAX_GUESSES}`;
    const stats = loadStats();
    const streakLine = stats.streak > 1 ? `\n🔥 ${stats.streak}-day streak` : '';
    return `🕵️ Mystery Player #${puzzleNo} — ${score}\n${rows}${streakLine}\nCan you guess today's World Cup star?`;
  }

  function showResult(won: boolean, stats: Stats) {
    $('input-area').classList.add('hidden');
    const panel = $('result');
    panel.classList.remove('hidden');
    $('result-headline').textContent = won
      ? ['', 'Unreal — first try! 🐐', 'Brilliant! 🔥', 'Great work! 👏', 'Solid! 💪', 'Cut it close! 😅', 'Phew — last guess! 🫣'][state.guesses.length]
      : 'Out of guesses! 😩';
    $('result-answer').textContent = `The mystery player was ${answer.name} (${answer.nation}, ${answer.position}, ${answer.club}).`;

    if (stats.streak >= 1 && won) {
      const el = $('streak-line');
      el.textContent = stats.streak === 1 ? '🔥 Streak started — come back tomorrow!' : `🔥 ${stats.streak}-day streak!`;
      el.classList.remove('hidden');
    }

    $('st-played').textContent = String(stats.played);
    $('st-streak').textContent = String(stats.streak);
    $('st-max').textContent = String(stats.maxStreak);

    const maxDist = Math.max(1, ...Object.values(stats.dist));
    $('dist').innerHTML = Array.from({ length: MAX_GUESSES }, (_, i) => {
      const n = stats.dist[String(i + 1)] || 0;
      const w = Math.max(8, Math.round((n / maxDist) * 100));
      return `<div class="flex items-center gap-2 text-xs">
        <span class="w-3 font-bold text-slate-500">${i + 1}</span>
        <div class="h-4 rounded bg-pitch text-right text-[10px] font-bold leading-4 text-white" style="width:${w}%">${n || ''}</div>
      </div>`;
    }).join('');

    // Share links
    const text = shareText(won);
    const u = encodeURIComponent(SITE_URL);
    const t = encodeURIComponent(text);
    ($('sh-wa') as HTMLAnchorElement).href = `https://wa.me/?text=${t}%20${u}`;
    ($('sh-x') as HTMLAnchorElement).href = `https://twitter.com/intent/tweet?text=${t}&url=${u}`;
    ($('sh-tg') as HTMLAnchorElement).href = `https://t.me/share/url?url=${u}&text=${t}`;
    $('copy').addEventListener('click', async (e) => {
      try {
        await navigator.clipboard.writeText(text + '\n' + SITE_URL);
        (e.target as HTMLElement).textContent = 'Copied! ✅';
        setTimeout(() => ((e.target as HTMLElement).textContent = 'Copy result'), 1500);
        const w = window as any;
        if (w.gtag) w.gtag('event', 'mystery_share', { puzzle: puzzleNo });
      } catch {}
    });

    // Countdown to local midnight
    const cd = $('countdown');
    const tick = () => {
      const now = new Date();
      const mid = new Date(now); mid.setHours(24, 0, 0, 0);
      const ms = mid.getTime() - now.getTime();
      const h = Math.floor(ms / 36e5), m = Math.floor((ms % 36e5) / 6e4), s = Math.floor((ms % 6e4) / 1e3);
      cd.textContent = `Next mystery player in ${h}h ${String(m).padStart(2, '0')}m ${String(s).padStart(2, '0')}s`;
    };
    tick();
    setInterval(tick, 1000);
  }

  function submitGuess(p: MysteryPlayer) {
    if (state.result || state.guesses.includes(p.id)) return;
    state.guesses.push(p.id);
    const fb = compareGuess(p, answer);
    if (fb.correct) state.result = 'win';
    else if (state.guesses.length >= MAX_GUESSES) state.result = 'lose';
    save();
    renderBoard();
    const w = window as any;
    if (w.gtag) w.gtag('event', 'mystery_guess', { n: state.guesses.length, puzzle: puzzleNo });
    if (state.result) finishGame(state.result === 'win');
  }

  // ---- Autocomplete ----
  const input = $('guess-input') as HTMLInputElement;
  const list = $('ac-list');
  let matches: MysteryPlayer[] = [];
  let active = -1;

  function renderAc() {
    if (matches.length === 0) { list.classList.add('hidden'); return; }
    list.classList.remove('hidden');
    list.innerHTML = matches
      .map((p, i) => `<li data-id="${p.id}" class="cursor-pointer px-4 py-2 text-sm ${i === active ? 'bg-pitch text-white' : 'hover:bg-slate-50'}">
        <span class="font-semibold">${p.name}</span>
        <span class="${i === active ? 'text-white/70' : 'text-slate-400'}"> · ${p.nation} · ${p.position}</span>
      </li>`)
      .join('');
  }

  input.addEventListener('input', () => {
    const q = norm(input.value.trim());
    active = -1;
    matches = q.length < 2 ? [] : players
      .filter((p) => norm(p.name).includes(q) && !state.guesses.includes(p.id))
      .slice(0, 8);
    renderAc();
  });

  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') { active = Math.min(active + 1, matches.length - 1); renderAc(); e.preventDefault(); }
    else if (e.key === 'ArrowUp') { active = Math.max(active - 1, 0); renderAc(); e.preventDefault(); }
    else if (e.key === 'Enter') {
      const pick = matches[active >= 0 ? active : 0];
      if (pick) { input.value = ''; matches = []; renderAc(); submitGuess(pick); }
      e.preventDefault();
    } else if (e.key === 'Escape') { matches = []; renderAc(); }
  });

  list.addEventListener('mousedown', (e) => {
    const li = (e.target as HTMLElement).closest('li');
    if (!li) return;
    const p = byId.get(li.dataset.id!);
    if (p) { input.value = ''; matches = []; renderAc(); submitGuess(p); }
  });

  document.addEventListener('click', (e) => {
    if (!list.contains(e.target as Node) && e.target !== input) { matches = []; renderAc(); }
  });

  // ---- Init ----
  renderBoard();
  if (state.result) finishGame(state.result === 'win');
</script>
