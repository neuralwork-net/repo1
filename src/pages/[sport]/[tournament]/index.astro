---
import Base from '../../../layouts/Base.astro';
import AdSlot from '../../../components/AdSlot.astro';
import QuizCard from '../../../components/QuizCard.astro';
import { SPORTS, findSport, findTournament } from '../../../data/sports';
import { quizzesFor } from '../../../lib/quizzes';

export function getStaticPaths() {
  return SPORTS.flatMap((sport) =>
    sport.tournaments.map((t) => ({
      params: { sport: sport.id, tournament: t.id },
    })),
  );
}

const { sport, tournament } = Astro.params;
const sportData = findSport(sport!)!;
const tData = findTournament(sport!, tournament!)!;
const quizzes = quizzesFor(sport!, tournament!);
const categories = [...new Set(quizzes.map((q) => q.category ?? 'Other'))].sort();
const breadcrumbs = [
  { label: sportData.name, href: `/${sportData.id}/` },
  { label: tData.name, href: '' },
];
---
<Base
  title={tData.name}
  description={`Free ${tData.name} quizzes — teams, players, history and more. Test your knowledge and challenge your friends!`}
  breadcrumbs={breadcrumbs}
>
  <a href={`/${sportData.id}/`} class="text-sm text-slate-400 hover:text-pitch">← {sportData.name}</a>
  <h1 class="mt-2 text-2xl font-bold">{tData.emoji} {tData.name}</h1>
  {tData.blurb && <p class="mt-1 text-slate-600">{tData.blurb}</p>}

  <a href="/predict/" class="mt-4 flex items-center gap-3 rounded-xl bg-gradient-to-r from-pitch to-pitch-dark p-4 text-white hover:brightness-105">
    <span class="text-2xl">🗺️</span>
    <span>
      <span class="block font-bold">Predict the tournament</span>
      <span class="text-sm text-white/80">All 104 matches · bracket · pick the champion</span>
    </span>
    <span class="ml-auto font-bold">→</span>
  </a>

  <AdSlot label="Top ad" />

  {quizzes.length > 0 && categories.length > 1 && (
    <div id="quiz-filters" class="mt-5 flex flex-wrap gap-2">
      <button type="button" data-category="all" class="filter-chip rounded-full bg-pitch px-4 py-1.5 text-sm font-semibold text-white">All</button>
      {categories.map((c) => (
        <button type="button" data-category={c} class="filter-chip rounded-full border border-slate-300 bg-white px-4 py-1.5 text-sm font-semibold text-slate-600 hover:border-pitch">{c}</button>
      ))}
    </div>
  )}

  {quizzes.length ? (
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      {quizzes.map((quiz) => <QuizCard quiz={quiz} />)}
    </div>
  ) : (
    <p class="mt-6 text-slate-500">Quizzes coming soon — check back at kickoff.</p>
  )}

  <script is:inline>
    const chips = document.querySelectorAll('#quiz-filters .filter-chip');
    const active = ['bg-pitch', 'text-white'];
    const inactive = ['border', 'border-slate-300', 'bg-white', 'text-slate-600'];
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        chips.forEach((c) => {
          c.classList.remove(...active, ...inactive);
          c.classList.add(...(c === chip ? active : inactive));
        });
        const cat = chip.dataset.category;
        document.querySelectorAll('.quiz-card').forEach((card) => {
          card.style.display = cat === 'all' || card.dataset.category === cat ? '' : 'none';
        });
      });
    });
  </script>
</Base>
