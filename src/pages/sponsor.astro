---
import Base from '../layouts/Base.astro';
import { SITE } from '../lib/site';
---
<Base title="Advertise" description="Sponsor a quiz and reach engaged sports fans.">
  <h1 class="text-2xl font-bold">Advertise on {SITE.name}</h1>
  <p class="mt-3 text-slate-600">
    Reach engaged sports fans during the world's biggest tournaments. Options:
  </p>
  <ul class="mt-4 space-y-3 text-slate-700">
    <li class="rounded-xl border border-slate-200 bg-white p-4">
      <strong>Sponsored quiz</strong> — your brand featured in a custom quiz played and shared by fans. Logo, links, and a call-to-action.
    </li>
    <li class="rounded-xl border border-slate-200 bg-white p-4">
      <strong>Banner placement</strong> — fixed slots on high-traffic quiz and results pages.
    </li>
    <li class="rounded-xl border border-slate-200 bg-white p-4">
      <strong>Email feature</strong> — a mention to our match-day quiz subscribers.
    </li>
  </ul>
  <p class="mt-6 text-slate-600">
    Get in touch: <a class="font-semibold text-pitch underline" href={`mailto:ads@${SITE.domain}`}>ads@{SITE.domain}</a>
  </p>
</Base>
