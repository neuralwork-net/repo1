---
import type { Quiz } from '../lib/types';
interface Props { quiz: Quiz; }
const { quiz } = Astro.props;
---
<a
  href={`/quiz/${quiz.slug}/1/`}
  class="group block rounded-2xl border border-slate-200 bg-white p-5 transition hover:-translate-y-0.5 hover:border-pitch hover:shadow-md"
>
  <div class="flex items-center gap-3">
    <span class="text-3xl">{quiz.emoji ?? '⚽'}</span>
    <div>
      <h3 class="font-bold text-slate-900 group-hover:text-pitch">{quiz.title}</h3>
      <p class="text-xs text-slate-500">{quiz.questions.length} questions{quiz.daily ? ' · Daily' : ''}</p>
    </div>
  </div>
  <p class="mt-2 text-sm text-slate-600">{quiz.description}</p>
  <span class="mt-3 inline-block text-sm font-semibold text-pitch">Play now →</span>
</a>
