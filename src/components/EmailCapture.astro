---
import { INTEGRATIONS } from '../lib/site';
const { emailFormEndpoint } = INTEGRATIONS;
---
{emailFormEndpoint ? (
  <form
    action={emailFormEndpoint}
    method="POST"
    class="mt-6 rounded-xl border border-slate-200 bg-white p-5"
  >
    <p class="font-semibold text-slate-800">Get the next quiz first 🔔</p>
    <p class="mt-1 text-sm text-slate-500">New quiz every match day. No spam.</p>
    <div class="mt-3 flex gap-2">
      <input
        type="email"
        name="email"
        required
        placeholder="you@email.com"
        class="flex-1 rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-pitch focus:outline-none"
      />
      <button class="rounded-lg bg-pitch px-4 py-2 text-sm font-semibold text-white hover:bg-pitch-dark">
        Notify me
      </button>
    </div>
  </form>
) : null}
