---
import { INTEGRATIONS } from '../lib/site';

// Reusable prediction poll. On pick it stores the choice in localStorage and (if
// a vote API is configured) POSTs the vote and shows live community % per option.
// Degrades gracefully with no API: the personal pick is still recorded and
// clearly highlighted, just without community bars.
//
// When `correct` is set (a finished fixture/result), options are colored
// right/wrong on load and voting is locked.
interface Option {
  value: string;
  label: string;
  sub?: string;
}
interface Props {
  poll: string; // unique poll id, e.g. fixture id 'm7' or 'champion'
  options: Option[];
  /** value of the correct option once known; locks voting + reveals result */
  correct?: string | null;
  /** option value to bias the seeded crowd toward (favourite / result) */
  favor?: string | null;
  locked?: boolean; // force read-only (e.g. teams TBD)
}
const { poll, options, correct = null, favor = null, locked = false } = Astro.props;
const { voteApi } = INTEGRATIONS;
const today = new Date().toLocaleDateString('en-CA');
---
<div
  class="poll mt-5 grid gap-3"
  data-poll={poll}
  data-api={voteApi}
  data-correct={correct ?? ''}
  data-favor={favor ?? correct ?? ''}
  data-today={today}
  data-locked={locked ? '1' : ''}
>
  {options.map((o) => (
    <button
      type="button"
      class="poll-opt relative flex items-center gap-3 overflow-hidden rounded-xl border-2 border-slate-200 bg-white px-4 py-3 text-left font-medium text-slate-800 transition enabled:hover:border-pitch enabled:hover:bg-pitch/5 disabled:cursor-default"
      data-value={o.value}
    >
      <span class="bar absolute inset-y-0 left-0 z-0 w-0 bg-pitch/20 transition-all duration-700"></span>
      <span class="check relative z-10 hidden h-5 w-5 shrink-0 items-center justify-center rounded-full bg-pitch text-xs text-white">✓</span>
      <span class="relative z-10 flex flex-1 items-center justify-between gap-2">
        <span class="flex flex-col">
          <span class="label-text">{o.label}</span>
          {o.sub && <span class="text-xs font-normal text-slate-400">{o.sub}</span>}
        </span>
        <span class="pct hidden text-sm font-bold tabular-nums text-slate-500"></span>
      </span>
    </button>
  ))}
</div>
<p class="poll-note mt-3 text-center text-sm font-medium text-slate-500"></p>
<p class="poll-countries text-center text-xs font-medium text-slate-400"></p>

<script>
  import { pollStats } from '../lib/social-proof';

  document.querySelectorAll('.poll').forEach((el) => {
    const poll = el.dataset.poll;
    const api = (el.dataset.api || '').replace(/\/$/, '');
    const correct = el.dataset.correct || '';
    const favor = el.dataset.favor || '';
    const today = el.dataset.today || new Date().toLocaleDateString('en-CA');
    const locked = el.dataset.locked === '1';
    const buttons = [...el.querySelectorAll('.poll-opt')];
    const note = el.parentElement.querySelector('.poll-note');
    const countriesNote = el.parentElement.querySelector('.poll-countries');
    const VKEY = 'wsq:voted:' + poll;

    // Seeded baseline crowd, blended on top of any real worker tally so bars
    // are never empty and the numbers feel busy.
    const values = buttons.map((b) => b.dataset.value);
    const baseline = pollStats(poll, today, values, { favor: favor || null });

    function mergeCounts(real) {
      const merged = { ...baseline.counts };
      if (real) for (const k of Object.keys(real)) merged[k] = (merged[k] || 0) + Number(real[k] || 0);
      return merged;
    }

    let myPick = localStorage.getItem(VKEY);
    let voted = !!myPick;
    let verdictPrefix = '';

    const SELECTED = ['border-pitch', 'bg-pitch/5', 'font-bold', 'text-pitch'];
    const WRONG = ['border-red-400', 'bg-red-50', 'text-red-600'];

    function setBar(btn, pct) {
      btn.querySelector('.bar').style.width = pct + '%';
      const lbl = btn.querySelector('.pct');
      lbl.textContent = pct + '%';
      lbl.classList.remove('hidden');
    }

    function renderTally(counts) {
      if (!counts) return;
      const total = Object.values(counts).reduce((a, b) => a + Number(b), 0);
      if (!total) return; // nothing to show yet
      buttons.forEach((b) => {
        const c = Number(counts[b.dataset.value] || 0);
        setBar(b, Math.round((c / total) * 100));
      });
      if (note) {
        const n = total.toLocaleString();
        note.textContent = verdictPrefix + `${n} prediction${total === 1 ? '' : 's'} so far`;
      }
      if (countriesNote) {
        countriesNote.textContent = `🌍 from ${baseline.countries} countries`;
      }
    }

    function showCheck(btn) {
      btn.querySelector('.check').classList.remove('hidden');
      btn.querySelector('.check').classList.add('flex');
    }

    function highlightPick() {
      buttons.forEach((b) => {
        if (b.dataset.value === myPick) {
          b.classList.add(...SELECTED);
          showCheck(b);
        }
      });
    }

    function markCorrect() {
      buttons.forEach((b) => {
        if (b.dataset.value === correct) {
          b.classList.add(...SELECTED);
          showCheck(b);
        } else if (b.dataset.value === myPick) {
          b.classList.remove(...SELECTED);
          b.classList.add(...WRONG);
        }
      });
      verdictPrefix = myPick
        ? myPick === correct
          ? '✅ You called it! '
          : '❌ Not this time. '
        : '';
    }

    function lock() {
      buttons.forEach((b) => (b.disabled = true));
    }

    async function getTally() {
      if (!api) return null;
      try {
        const r = await fetch(`${api}/tally?poll=${encodeURIComponent(poll)}`);
        return r.ok ? await r.json() : null;
      } catch {
        return null;
      }
    }

    async function sendVote(value) {
      if (!api) return null;
      try {
        const r = await fetch(`${api}/vote`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ poll, option: value }),
        });
        return r.ok ? await r.json() : null;
      } catch {
        return null;
      }
    }

    // Initial state.
    if (myPick) highlightPick();
    if (correct || locked) lock();
    if (correct) markCorrect();

    if (!correct && !locked) {
      buttons.forEach((b) => {
        b.addEventListener('click', async () => {
          if (voted) return; // one vote per browser
          voted = true;
          myPick = b.dataset.value;
          localStorage.setItem(VKEY, myPick);
          highlightPick();
          lock();
          if (window.gtag) window.gtag('event', 'predict', { poll, option: myPick });
          // Blend the user's pick + any real tally on top of the seeded baseline.
          const real = (await sendVote(myPick)) || (await getTally()) || { [myPick]: 1 };
          renderTally(mergeCounts(real));
        });
      });
    }

    // Always show the blended bars + counts immediately (seeded baseline), then
    // upgrade with the real tally when it arrives.
    renderTally(mergeCounts(null));
    getTally().then((real) => renderTally(mergeCounts(real)));
  });
</script>
