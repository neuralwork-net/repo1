---
import { INTEGRATIONS } from '../lib/site';
// AdSense slot with a graceful house-ad fallback while AdSense is pending/unapproved.
// Pass a `slot` id (from AdSense) once you have ad units; until then it shows the fallback.
interface Props {
  slot?: string;
  label?: string;
  class?: string;
}
const { slot = '', label = 'Advertisement', class: cls = '' } = Astro.props;
const { adsenseClient } = INTEGRATIONS;
const live = adsenseClient && slot;
---
<aside class:list={['ad-slot my-6', cls]} aria-label={label}>
  {live ? (
    <ins
      class="adsbygoogle block"
      style="display:block"
      data-ad-client={adsenseClient}
      data-ad-slot={slot}
      data-ad-format="auto"
      data-full-width-responsive="true"
    ></ins>
    <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
  ) : (
    <div class="rounded-xl border border-dashed border-slate-300 bg-white/60 p-6 text-center text-sm text-slate-400">
      Ad space — sponsor this quiz · <a class="underline" href="/sponsor/">advertise here</a>
    </div>
  )}
</aside>
