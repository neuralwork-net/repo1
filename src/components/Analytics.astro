---
import { INTEGRATIONS } from '../lib/site';
const { ga4Id, plausibleDomain } = INTEGRATIONS;
// Emit the standard gtag snippet verbatim (global gtag, no IIFE) so Google's
// tag detector recognizes it. ga4Id is a trusted config constant, not user input.
const gaSnippet = ga4Id
  ? `window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', '${ga4Id}');`
  : '';
---
{ga4Id && (
  <>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}></script>
    <script is:inline set:html={gaSnippet}></script>
  </>
)}
{plausibleDomain && (
  <script is:inline defer data-domain={plausibleDomain} src="https://plausible.io/js/script.js"></script>
)}
